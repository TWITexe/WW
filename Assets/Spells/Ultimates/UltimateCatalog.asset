  definitions:
  - kind: 0
    title: "\u041F\u0440\u0438\u0437\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0439
      \u0437\u0430\u043B\u043F"
    description: "\u0427\u0435\u0442\u044B\u0440\u0435 \u043A\u0440\u0438\u0441\u0442\u0430\u043B\u043B\u0430
      \u043D\u0430 15 \u0441 \u043D\u0430\u043A\u0430\u043F\u043B\u0438\u0432\u0430\u044E\u0442
      \u043A\u043E\u043F\u0438\u0438 \u0444\u0430\u0435\u0440\u0431\u043E\u043B\u043B\u043E\u0432
      \u0438 \u043B\u0435\u0434\u044F\u043D\u044B\u0445 \u043A\u043E\u043F\u0438\u0439
      \u0441 60% \u0443\u0440\u043E\u043D\u0430. F \u0432\u044B\u043F\u0443\u0441\u043A\u0430\u0435\u0442
      \u043D\u0430\u043A\u043E\u043F\u043B\u0435\u043D\u043D\u044B\u0439 \u0437\u0430\u043B\u043F."
    elements: 000000000100000002000000
    duration: 15
    color: {r: 1, g: 0.4, b: 0.12, a: 1}
    worldPrefab: {fileID: 0}
  - kind: 1
    title: "\u0420\u043E\u0436\u0434\u0435\u043D\u0438\u0435 \u0424\u0435\u043D\u0438\u043A\u0441\u0430"
    description: "\u0410\u0443\u0440\u0430 \u0434\u043E \u043F\u0435\u0440\u0432\u043E\u0433\u043E
      \u0441\u043C\u0435\u0440\u0442\u0435\u043B\u044C\u043D\u043E\u0433\u043E \u0443\u0434\u0430\u0440\u0430.
      \u0412\u043C\u0435\u0441\u0442\u043E \u0441\u043C\u0435\u0440\u0442\u0438 \u043C\u0430\u0433
      \u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u0441\u044F \u043C\u0435\u0442\u0435\u043E\u0440\u0438\u0442\u043E\u043C
      \u0441 500 HP \u043D\u0430 4 \u0441. \u0415\u0441\u043B\u0438 \u043C\u0435\u0442\u0435\u043E\u0440\u0438\u0442
      \u0443\u0446\u0435\u043B\u0435\u043B, \u043C\u0430\u0433 \u0432\u043E\u0437\u0432\u0440\u0430\u0449\u0430\u0435\u0442\u0441\u044F
      \u0441 \u043F\u043E\u043B\u043D\u044B\u043C \u0437\u0434\u043E\u0440\u043E\u0432\u044C\u0435\u043C."
    elements: 000000000100000003000000
    duration: 0
    color: {r: 1, g: 0.02, b: 0.035, a: 1}
    worldPrefab: {fileID: 0}
  - kind: 2
    title: "\u041F\u0430\u0440\u043E\u0432\u043E\u0439 \u0434\u0432\u0438\u0433\u0430\u0442\u0435\u043B\u044C"
    description: "\u041D\u0430 15 \u0441 \u0432\u043A\u043B\u044E\u0447\u0430\u0435\u0442
      \u043F\u043E\u043B\u0451\u0442 \u0438 \u0441\u0440\u0430\u0437\u0443 \u043F\u043E\u0434\u0431\u0440\u0430\u0441\u044B\u0432\u0430\u0435\u0442
      \u043C\u0430\u0433\u0430 \u043D\u0430 \u0432\u044B\u0441\u043E\u0442\u0443
      \u0435\u0433\u043E \u0440\u043E\u0441\u0442\u0430. WASD \u2014 \u0434\u0432\u0438\u0436\u0435\u043D\u0438\u0435,
      \u041F\u0440\u043E\u0431\u0435\u043B \u2014 \u0432\u0432\u0435\u0440\u0445,
      Shift \u2014 \u0432\u043D\u0438\u0437, F \u2014 \u0437\u0430\u0432\u0435\u0440\u0448\u0438\u0442\u044C.
      \u041F\u043E\u0442\u043E\u043B\u043E\u043A \u043F\u043E\u043B\u0451\u0442\u0430
      \u2014 12 \u043C \u043E\u0442 \u0441\u0442\u0430\u0440\u0442\u0430."
    elements: 000000000100000004000000
    duration: 15
    color: {r: 0.8333333, g: 0.5, b: 0.31555554, a: 1}
    worldPrefab: {fileID: 0}
  - kind: 3
    title: "\u0414\u0443\u0445 3 \u0441\u0442\u0438\u0445\u0438\u0439"
    description: "\u0413\u043E\u043B\u0435\u043C \u043D\u0430 10 \u0441, 200 HP.
      WASD \u2014 \u0445\u043E\u0434\u044C\u0431\u0430, \u041F\u0440\u043E\u0431\u0435\u043B
      \u2014 \u043F\u0440\u044B\u0436\u043E\u043A. \u041B\u041A\u041C: \u0440\u0430\u0437\u043C\u0430\u0448\u0438\u0441\u0442\u044B\u0439
      \u0443\u0434\u0430\u0440 \u0441\u043B\u0435\u0432\u0430 \u043D\u0430\u043F\u0440\u0430\u0432\u043E
      \u0438 \u043E\u0433\u043D\u0435\u043D\u043D\u044B\u0439 \u0440\u0430\u0437\u043B\u043E\u043C
      \u043D\u0430 30 \u0443\u0440\u043E\u043D\u0430. \u041F\u041A\u041C: \u0443\u0434\u0430\u0440
      \u0441\u043F\u0440\u0430\u0432\u0430 \u043D\u0430\u043B\u0435\u0432\u043E \u0438
      \u043C\u043E\u0440\u043E\u0437 \u043D\u0430 20 \u0443\u0440\u043E\u043D\u0430,
      \u0437\u0430\u043C\u0435\u0434\u043B\u044F\u044E\u0449\u0438\u0439 \u043D\u0430
      50% \u043D\u0430 2 \u0441. \u0413\u0438\u0431\u0435\u043B\u044C \u0433\u043E\u043B\u0435\u043C\u0430
      \u0443\u0431\u0438\u0432\u0430\u0435\u0442 \u043C\u0430\u0433\u0430."
    elements: 000000000200000003000000
    duration: 10
    color: {r: 0.75, g: 0.55, b: 0.41333333, a: 1}
    worldPrefab: {fileID: 0}
  - kind: 4
    title: "\u041F\u043E\u0445\u0438\u0449\u0435\u043D\u0438\u0435 \u044D\u043D\u0435\u0440\u0433\u0438\u0438"
    description: "\u041B\u0443\u0447 \u043D\u0430 7 \u0441: 20 \u0443\u0440\u043E\u043D\u0430/\u0441,
      \u043B\u0435\u0447\u0435\u043D\u0438\u0435 \u0432\u043B\u0430\u0434\u0435\u043B\u044C\u0446\u0430
      \u043D\u0430 100% \u043D\u0430\u043D\u0435\u0441\u0451\u043D\u043D\u043E\u0433\u043E
      \u0443\u0440\u043E\u043D\u0430. \u0421\u043E\u044E\u0437\u043D\u0438\u043A\u0438
      \u0432 6 \u043C \u043F\u043E\u043B\u0443\u0447\u0430\u044E\u0442 50%. \u0423\u043A\u0440\u044B\u0442\u0438\u044F
      \u0431\u043B\u043E\u043A\u0438\u0440\u0443\u044E\u0442 \u043B\u0443\u0447;
      \u0432\u043E \u0432\u0440\u0435\u043C\u044F \u043F\u0440\u0438\u043C\u0435\u043D\u0435\u043D\u0438\u044F
      \u043E\u0431\u044B\u0447\u043D\u044B\u0435 \u0437\u0430\u043A\u043B\u0438\u043D\u0430\u043D\u0438\u044F
      \u043D\u0435\u0434\u043E\u0441\u0442\u0443\u043F\u043D\u044B."
    elements: 000000000200000004000000
    duration: 7
    color: {r: 0.8, g: 0.02, b: 0.04, a: 1}
    worldPrefab: {fileID: 0}
  - kind: 5
    title: "\u041D\u0435\u0434\u0440\u0430 \u0437\u0435\u043C\u043B\u0438"
    description: "\u041F\u043E\u0434 \u043C\u0430\u0433\u043E\u043C \u043F\u043E\u0434\u043D\u0438\u043C\u0430\u0435\u0442\u0441\u044F
      \u043E\u0441\u0442\u0440\u043E\u0432 \u043D\u0430 \u0432\u044B\u0441\u043E\u0442\u0443
      5 \u043C. \u0416\u0430\u0440 \u043D\u0430 \u043F\u043E\u0432\u0435\u0440\u0445\u043D\u043E\u0441\u0442\u0438:
      12 \u0443\u0440\u043E\u043D\u0430/\u0441. F \u0438\u043B\u0438 \u043A\u043E\u043D\u0435\u0446
      27 \u0441: \u043E\u0441\u0442\u0440\u043E\u0432 \u043F\u0430\u0434\u0430\u0435\u0442
      \u0438 \u043F\u0440\u0438 \u0443\u0434\u0430\u0440\u0435 \u0432\u0437\u0440\u044B\u0432\u0430\u0435\u0442\u0441\u044F
      \u043D\u0430 30 \u0443\u0440\u043E\u043D\u0430 \u0432 \u0440\u0430\u0434\u0438\u0443\u0441\u0435
      6 \u043C."
    elements: 000000000300000004000000
    duration: 27
    color: {r: 0.5833333, g: 0.65000004, b: 0.6088889, a: 1}
    worldPrefab: {fileID: 6222008272590112422, guid: a832499fbcd91924cbcd86da0acba4d4, type: 3}
  - kind: 6
    title: "\u0417\u0435\u0440\u043A\u0430\u043B\u044C\u043D\u044B\u0439 \u043B\u0430\u0431\u0438\u0440\u0438\u043D\u0442"
    description: "\u0428\u0435\u0441\u0442\u044C \u0437\u0435\u0440\u043A\u0430\u043B
      \u043F\u043E 90 HP: \u041B\u041A\u041C \u2014 \u043F\u043E\u0441\u0442\u0430\u0432\u0438\u0442\u044C,
      \u043A\u043E\u043B\u0435\u0441\u043E \u2014 \u043F\u043E\u0432\u0435\u0440\u043D\u0443\u0442\u044C,
      \u041F\u041A\u041C \u2014 \u0443\u0431\u0440\u0430\u0442\u044C \u043F\u0440\u0438\u0446\u0435\u043B,
      F \u2014 \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0438\u0442\u044C. 45 \u0441
      \u043D\u0430 \u0440\u0430\u0437\u043C\u0435\u0449\u0435\u043D\u0438\u0435,
      \u043F\u043E\u0441\u043B\u0435 \u0448\u0435\u0441\u0442\u043E\u0433\u043E \u2014
      27 \u0441 \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044F. \u0417\u0435\u0440\u043A\u0430\u043B\u0430
      \u043E\u0442\u0440\u0430\u0436\u0430\u044E\u0442 \u0441\u043D\u0430\u0440\u044F\u0434\u044B."
    elements: 010000000200000003000000
    duration: 27
    color: {r: 0.5, g: 0.70000005, b: 0.7066667, a: 1}
    worldPrefab: {fileID: 7082260746237685556, guid: cf648dcd6a9af4f49954598ae00e3a16, type: 3}
  - kind: 7
    title: "\u041F\u043E\u043B\u044F\u0440\u043D\u044B\u0439 \u043F\u0440\u043E\u0431\u043E\u0439"
    description: "\u0422\u0440\u0438 \u043C\u0433\u043D\u043E\u0432\u0435\u043D\u043D\u044B\u0445
      \u0432\u044B\u0441\u0442\u0440\u0435\u043B\u0430 \u0441\u043A\u0432\u043E\u0437\u044C
      \u0441\u0442\u0435\u043D\u044B: 80 \u0443\u0440\u043E\u043D\u0430 \u0432 \u0442\u0435\u043B\u043E,
      120 \u0432 \u0433\u043E\u043B\u043E\u0432\u0443, \u0431\u0435\u0437 \u0440\u0430\u0437\u0431\u0440\u043E\u0441\u0430.
      \u041B\u041A\u041C \u2014 \u0432\u044B\u0441\u0442\u0440\u0435\u043B, \u0438\u043D\u0442\u0435\u0440\u0432\u0430\u043B
      0,7 \u0441. \u0417\u0430\u0440\u044F\u0434\u044B \u0434\u043E\u0441\u0442\u0443\u043F\u043D\u044B
      10 \u0441. \u041B\u0443\u0447 \u043E\u0441\u0442\u0430\u043D\u0430\u0432\u043B\u0438\u0432\u0430\u0435\u0442\u0441\u044F
      \u043D\u0430 \u043F\u0435\u0440\u0432\u043E\u043C \u0438\u0433\u0440\u043E\u043A\u0435."
    elements: 010000000200000004000000
    duration: 10
    color: {r: 0.41666666, g: 0.75, b: 0.80444443, a: 1}
    worldPrefab: {fileID: 0}
  - kind: 8
    title: "\u0413\u0440\u0430\u0432\u0438\u0442\u0430\u0446\u0438\u043E\u043D\u043D\u043E\u0435
      \u043F\u043E\u043B\u0435"
    description: "\u041F\u043E\u043B\u0435 \u0440\u0430\u0434\u0438\u0443\u0441\u043E\u043C
      12 \u043C \u043F\u043E\u0434\u043D\u0438\u043C\u0430\u0435\u0442 \u0438\u0433\u0440\u043E\u043A\u043E\u0432
      \u043D\u0430 12 \u043C. F: \u043F\u0440\u0435\u0434\u0443\u043F\u0440\u0435\u0436\u0434\u0435\u043D\u0438\u0435
      0,8 \u0441 \u0438 \u043E\u0431\u0440\u0443\u0448\u0435\u043D\u0438\u0435. \u0423\u0434\u0430\u0440
      \u043E \u0437\u0435\u043C\u043B\u044E \u043D\u0430\u043D\u043E\u0441\u0438\u0442
      40 \u0443\u0440\u043E\u043D\u0430 \u0438 \u0441\u043E\u0437\u0434\u0430\u0451\u0442
      hit-\u044D\u0444\u0444\u0435\u043A\u0442."
    elements: 010000000300000004000000
    duration: 6
    color: {r: 0.3333333, g: 0.8, b: 0.9022222, a: 1}
    worldPrefab: {fileID: 2011423957075133844, guid: 4d358df81d41c8d41a8916ea621b2130, type: 3}
  - kind: 9
    title: "\u041B\u0435\u0434\u043D\u0438\u043A\u043E\u0432\u044B\u0439 \u0442\u0430\u0440\u0430\u043D"
    description: "\u0421\u0444\u0435\u0440\u0430 \u043D\u0430 11 \u0441 \u0441 \u043A\u0430\u043C\u0435\u0440\u043E\u0439
      \u043E\u0442 \u0442\u0440\u0435\u0442\u044C\u0435\u0433\u043E \u043B\u0438\u0446\u0430.
      WASD \u2014 \u0434\u0432\u0438\u0436\u0435\u043D\u0438\u0435, \u041F\u0440\u043E\u0431\u0435\u043B
      \u2014 \u043F\u0440\u044B\u0436\u043E\u043A, \u043C\u044B\u0448\u044C \u2014
      \u043A\u0430\u043C\u0435\u0440\u0430. \u041C\u0430\u0433 \u0441\u0442\u043E\u0438\u0442
      \u043D\u0430 \u043C\u0435\u0441\u0442\u0435. \u0422\u0430\u0440\u0430\u043D:
      15 \u0443\u0440\u043E\u043D\u0430 \u0440\u0430\u0437 \u0432 \u0441\u0435\u043A\u0443\u043D\u0434\u0443.
      F / \u041B\u041A\u041C: \u0432\u0437\u0440\u044B\u0432 \u043D\u0430 40 \u0443\u0440\u043E\u043D\u0430
      \u0432 4 \u043C \u0438 \u043E\u0433\u043B\u0443\u0448\u0435\u043D\u0438\u0435
      \u043D\u0430 3 \u0441."
